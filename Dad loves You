function buildBigRoadColumns(hands) {
  const base = hands.filter(r => r === 'P' || r === 'B');
  const cols = [];
  base.forEach(r => {
    if (!cols.length || cols[cols.length - 1][0] !== r) cols.push([r]);
    else cols[cols.length - 1].push(r);
  });
  return cols;
}

// Standard 6-row Dragon Tail placement from index (11).html
function placeRoadSequence(items, valueOf) {
  const pos = [];
  const occupied = new Set();
  let col = -1, row = 0, last = null, streakStartCol = -1, turnedRight = false;

  items.forEach(item => {
    const value = valueOf(item);
    if (value !== last) {
      let candidate = streakStartCol + 1;
      while (occupied.has(`${candidate},0`)) candidate++;
      streakStartCol = candidate;
      col = streakStartCol;
      row = 0;
      turnedRight = false;
    } else {
      const canGoDown = !turnedRight && row < 5 && !occupied.has(`${col},${row + 1}`);
      if (canGoDown) {
        row++;
      } else {
        turnedRight = true;
        col++;
        while (occupied.has(`${col},${row}`)) col++;
      }
    }
    occupied.add(`${col},${row}`);
    pos.push({ ...item, col, row });
    last = value;
  });
  return pos;
}

function bigRoadPositions(hands) {
  const base = [];
  const tiesByIndex = [];
  let nonTieIndex = -1;
  let leadingTies = 0;

  hands.forEach(r => {
    if (r === 'T') {
      if (nonTieIndex >= 0) tiesByIndex[nonTieIndex] = (tiesByIndex[nonTieIndex] || 0) + 1;
      else leadingTies++;
    } else if (r === 'P' || r === 'B') {
      nonTieIndex++;
      base.push({ r });
    }
  });

  const placed = placeRoadSequence(base, x => x.r).map((x, i) => ({
    ...x,
    ties: (tiesByIndex[i] || 0) + (i === 0 ? leadingTies : 0)
  }));
  return { placed, leadingTiesOnly: base.length === 0 ? leadingTies : 0 };
}

function deriveRoad(hands, offset) {
  const cols = buildBigRoadColumns(hands);
  const marks = [];
  if (cols.length <= offset) return marks;
  for (let c = offset; c < cols.length; c++) {
    const currentLen = cols[c].length;
    const startRow = (c === offset) ? 1 : 0;
    for (let r = startRow; r < currentLen; r++) {
      let red;
      if (r === 0) {
        const nearLen = cols[c - 1]?.length || 0;
        const farLen = cols[c - 1 - offset]?.length || 0;
        red = nearLen === farLen;
