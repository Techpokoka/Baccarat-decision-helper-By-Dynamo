        const refLen = cols[c - offset]?.length || 0;
        const sameRowExists = refLen >= r + 1;
        const aboveRowExists = refLen >= r;
        red = sameRowExists === aboveRowExists;
      }
      marks.push(red ? 'R' : 'B');
    }
  }
  return marks;
}

function previewDerivedMark(hands, nextPB, offset) {
  const before = deriveRoad(hands, offset);
  const after = deriveRoad(hands.concat([nextPB]), offset);
  return after.length > before.length ? after[after.length - 1] : null;
}

function computeRhythm(pbStr) {
  let o = '';
  for (let i = 1; i < pbStr.length; i++) o += pbStr[i] === pbStr[i - 1] ? 'R' : 'S';
  return o;
}

function rebuildLibraryCache() {
  const unique = [...new Set(state.library.map(s => String(s || '').toUpperCase().replace(/[^PBT]/g, '')).filter(s => s.length >= 6))];
  state.library = unique;
  cachedLibrary = unique.map(seq => {
    const pb = seq.replace(/T/g, '');
    const arr = pb.split('');
    return {
      raw: seq,
      pb,
      rhythm: computeRhythm(pb),
      roads: {
        1: deriveRoad(arr, 1).join(''),
        2: deriveRoad(arr, 2).join(''),
        3: deriveRoad(arr, 3).join('')
      }
    };
  });
}

// Helper: find next non-Tie ('P' or 'B') at or after index j
function nextNonTie(str, j) {
  while (j < str.length && str[j] === 'T') j++;
  const ch = str[j];
  return (ch === 'P' || ch === 'B') ? ch : null;
}

// --- ENGINE 1: ROAD PREVIEW AI V7 ---
function runRoadPreviewAI() {
  const curRaw = state.hands;
  const curPB = curRaw.filter(r => r === 'P' || r === 'B');
  const searchSeq = state.ignoreTies ? curPB.join('') : curRaw.join('');
  if (curPB.length < 5) return { side: null, conf: 0, note: `Need ${5 - curPB.length} more P/B hands.` };

  // 1. Historical continuation matching (with automatic P/B fallback if Tie ending has sparse matches)
  const lengths = [16, 12, 8, 5].filter(k => k <= searchSeq.length);
  let pW = 0, bW = 0, matches = 0, bestLen = 0;

  for (const k of lengths) {
    const pat = searchSeq.slice(-k);
    const thresh = k >= 12 ? 0.80 : k >= 8 ? 0.84 : 0.90;
    for (const shObj of cachedLibrary) {
      const sh = state.ignoreTies ? shObj.pb : shObj.raw;
      if (sh.length <= k) continue;
      for (let pos = 0; pos + k < sh.length; pos++) {
        let same = 0;
        for (let j = 0; j < k; j++) if (sh[pos + j] === pat[j]) same++;
        const sim = same / k;
        if (sim < thresh) continue;
        const nx = nextNonTie(sh, pos + k);
        if (!nx) continue;
        const w = Math.pow(k, 1.55) * Math.pow(sim, 4);
        if (nx === 'P') pW += w; else bW += w;
        matches++;
        if (k > bestLen) bestLen = k;
      }
    }
  }

  // Fallback to P/B-only if a trailing Tie caused fewer than 3 matches
  if (matches < 3 && !state.ignoreTies && curPB.length >= 5) {
    const pbStr = curPB.join('');
    for (const k of [12, 8, 5].filter(x => x <= pbStr.length)) {
      const pat = pbStr.slice(-k);
      for (const shObj of cachedLibrary) {
        const sh = shObj.pb;
        for (let pos = 0; pos + k < sh.length; pos++) {
          let same = 0;
          for (let j = 0; j < k; j++) if (sh[pos + j] === pat[j]) same++;
          const sim = same / k;
          if (sim < 0.86) continue;
          const nx = sh[pos + k];
          const w = Math.pow(k, 1.45) * Math.pow(sim, 4);
          if (nx === 'P') pW += w; else bW += w;
          matches++;
          if (k > bestLen) bestLen = k;
        }
      }
    }
  }

  // 2. Live Derived Road probe
  let roadP = 0.5, roadReady = false, rVotesP = 0, rVotesB = 0;
  [1, 2, 3].forEach(off => {
    const marks = deriveRoad(curRaw, off);
    if (marks.length < 3) return;
    const last = marks.at(-1);
    let run = 1;
    for (let i = marks.length - 2; i >= 0 && marks[i] === last; i--) run++;
    const tail4 = marks.slice(-4).join('');
    const expected = run >= 2 ? last : ((tail4 === 'RBRB' || tail4 === 'BRBR') ? (last === 'R' ? 'B' : 'R') : last);
    const pM = previewDerivedMark(curRaw, 'P', off);
    const bM = previewDerivedMark(curRaw, 'B', off);
    if (pM && bM && pM !== bM) {
      if (pM === expected) rVotesP++; else rVotesB++;
    }
  });
  if (rVotesP + rVotesB >= 2) {
    roadReady = true;
    roadP = rVotesP / (rVotesP + rVotesB);
  }

  // 3. Bead Plate 6-Row structural alignment
  let beadPW = 0, beadBW = 0, beadMatches = 0;
  const row = searchSeq.length % 6;
  for (const shObj of cachedLibrary) {
    const sh = state.ignoreTies ? shObj.pb : shObj.raw;
    for (let pos = 6; pos < sh.length; pos++) {
      if (pos % 6 !== row) continue;
      const k = Math.min(10, searchSeq.length, pos);
      let same = 0;
      for (let j = 1; j <= k; j++) if (sh[pos - j] === searchSeq[searchSeq.length - j]) same++;
      const sim = same / k;
      if (sim >= 0.75) {
        const nx = nextNonTie(sh, pos);
        if (nx === 'P') { beadPW += sim; beadMatches++; }
        else if (nx === 'B') { beadBW += sim; beadMatches++; }
      }
    }
  }
  const beadReady = beadMatches >= 4;
  const beadP = beadReady ? beadPW / (beadPW + beadBW) : 0.5;

  const totHist = pW + bW;
  if (!totHist || matches < 3) return { side: null, conf: 0, note: 'WAIT: Insufficient historical matches.' };
  const histP = pW / totHist;

  let finalP = histP;
  if (roadReady && beadReady) finalP = 0.55 * histP + 0.30 * roadP + 0.15 * beadP;
  else if (roadReady) finalP = 0.68 * histP + 0.32 * roadP;
  else if (beadReady) finalP = 0.82 * histP + 0.18 * beadP;

  const pPct = Math.round(finalP * 100), bPct = 100 - pPct;
  const edge = Math.abs(pPct - bPct);
  const side = pPct > bPct ? 'P' : 'B';

  if (roadReady && ((side === 'P' && roadP < 0.34) || (side === 'B' && roadP > 0.66))) {
    return { side: null, conf: Math.max(pPct, bPct), note: 'WAIT: Live Derived Roads conflict with History.' };
  }
  if (edge < 10) return { side: null, conf: Math.max(pPct, bPct), note: `WAIT: Edge too close (${pPct}%/${bPct}%).` };

  const conf = Math.min(89, Math.round(52 + edge * 0.6));
  return { side, conf, note: `${matches} matches (best ${bestLen}h) • P ${pPct}% / B ${bPct}%.` };
}

// --- ENGINE 2: SEQUENCE AI V2 (HIGH SELECTIVITY) ---
function runSequenceAIV2() {
  const curPB = state.hands.filter(r => r === 'P' || r === 'B').join('');
  const curSeq = state.ignoreTies ? curPB : state.hands.join('');
  if (curPB.length < 4) return { side: null, conf: 0, note: 'Need 4+ P/B hands for Sequence V2.' };

  function scanPool(seqStr, usePB) {
    const lengths = [18, 14, 10, 8, 6, 4].filter(k => k <= seqStr.length);
    let windows = [], rawMatches = 0;
    for (const k of lengths) {
      const pat = seqStr.slice(-k);
      let sp = 0, sb = 0, hits = 0;
      for (const shObj of cachedLibrary) {
        const sh = usePB ? shObj.pb : shObj.raw;
        let p = 0, b = 0;
        for (let i = 0; i + k < sh.length; i++) {
          if (sh.slice(i, i + k) === pat) {
            const nx = nextNonTie(sh, i + k);
            if (nx === 'P') p++; else if (nx === 'B') b++;
          }
        }
        if (p + b > 0) {
          sp += p / (p + b);
          sb += b / (p + b);
          hits++;
        }
      }
      if (hits > 0) {
        rawMatches += hits;
        const pAvg = sp / hits, bAvg = sb / hits;
        windows.push({ k, pAvg, bAvg, leader: pAvg >= bAvg ? 'P' : 'B', weight: k * Math.min(1.2, hits / 4) });
      }
    }
    return { windows, rawMatches };
  }

  let { windows, rawMatches } = scanPool(curSeq, state.ignoreTies);
  // If live hand ends in Tie and exact-T windows are sparse, supplement with P/B windows
  if (rawMatches < 4 && !state.ignoreTies) {
    const fb = scanPool(curPB, true);
    if (fb.rawMatches > rawMatches) { windows = fb.windows; rawMatches = fb.rawMatches; }
  }

  if (!windows.length || rawMatches < 4) return { side: null, conf: 0, note: 'WAIT: Searching for multi-window sequence match.' };
  let pTot = 0, bTot = 0, wTot = 0;
  windows.forEach(w => { pTot += w.pAvg * w.weight; bTot += w.bAvg * w.weight; wTot += w.weight; });
  const pPct = Math.round((pTot / wTot) * 100), bPct = 100 - pPct;
  const side = pPct >= bPct ? 'P' : 'B';
  const agreeWin = windows.filter(w => w.leader === side).length;
  const agree = agreeWin / windows.length;
  const edge = Math.abs(pPct - bPct);

  if (agree < 0.65 || edge < 14) {
    return { side: null, conf: Math.max(pPct, bPct), note: `WAIT: Strict gate (${agreeWin}/${windows.length} win, ${edge}pt edge).` };
  }
  const conf = Math.min(90, Math.round(54 + edge * 0.55));
  return { side, conf, note: `QUALIFIED: ${rawMatches} shoe votes • ${agreeWin}/${windows.length} windows agree.` };
}

// --- ENGINE 3: DERIVED ROAD AI V3 (MULTI-WINDOW ONE-VOTE-PER-SHOE) ---
function runDerivedRoadAIV3() {
  const cur = state.hands;
  let votesP = 0, votesB = 0, activeRoads = 0;

  [1, 2, 3].forEach(off => {
    const liveMarks = deriveRoad(cur, off);
    const pMark = previewDerivedMark(cur, 'P', off);
    const bMark = previewDerivedMark(cur, 'B', off);
    if (liveMarks.length < 4 || !pMark || !bMark || pMark === bMark) return;

    const lengths = [12, 8, 6, 4].filter(k => k <= liveMarks.length);
    let rWeight = 0, bWeight = 0, shoesVoted = 0;

    for (const shObj of cachedLibrary) {
      const histMarks = shObj.roads[off];
      let bestVote = null, bestScore = 0;
      for (const k of lengths) {
        if (histMarks.length <= k) continue;
        const target = liveMarks.slice(-k);
        for (let pos = 0; pos + k < histMarks.length; pos++) {
          let hit = 0, max = 0;
          for (let j = 0; j < k; j++) {
            const rec = 0.6 + 0.8 * ((j + 1) / k);
            max += rec;
            if (target[j] === histMarks[pos + j]) hit += rec;
          }
          const sim = hit / max;
          if (sim < 0.78) continue;
          const nx = histMarks[pos + k];
          const sc = Math.pow(sim, 4) * (0.7 + k / 16);
          if (sc > bestScore) { bestScore = sc; bestVote = nx; }
        }
      }
      if (bestVote === 'R') { rWeight += bestScore; shoesVoted++; }
      else if (bestVote === 'B') { bWeight += bestScore; shoesVoted++; }
    }

    if (shoesVoted >= 3 && rWeight !== bWeight) {
      const expectedColor = rWeight > bWeight ? 'R' : 'B';
      const strength = Math.max(rWeight, bWeight) / (rWeight + bWeight);
      if (strength >= 0.55) {
        activeRoads++;
        if (pMark === expectedColor) votesP += strength;
        else if (bMark === expectedColor) votesB += strength;
      }
    }
  });

  if (activeRoads < 2 || votesP === votesB) {
    return { side: null, conf: 0, note: `WAIT: Need 2+ derived roads agreeing (${activeRoads}/3 ready).` };
  }
  const side = votesP > votesB ? 'P' : 'B';
  const ratio = Math.max(votesP, votesB) / (votesP + votesB);
  if (ratio < 0.56) return { side: null, conf: Math.round(ratio * 100), note: 'WAIT: Derived roads split.' };

  const conf = Math.min(88, Math.round(52 + (ratio - 0.5) * 72));
  return { side, conf, note: `${activeRoads}/3 Derived Roads mapped via P?/B? probe.` };
}

// --- ENGINE 4: BEAD PLATE HISTORY V503 + 20-HAND TRAJECTORY MATCHER ---
function runBeadHistoryV503() {
  const liveRaw = state.hands.join('');
  const pbSeq = state.hands.filter(r => r === 'P' || r === 'B').join('');
  if (pbSeq.length < 6) return { side: null, conf: 0, note: `Need ${6 - pbSeq.length} more P/B hands.` };

  // 1. V396 Exact Prefix Priority
  let exactP = 0, exactB = 0;
  for (const shObj of cachedLibrary) {
    if (shObj.pb.startsWith(pbSeq) && shObj.pb.length > pbSeq.length) {
      if (shObj.pb[pbSeq.length] === 'P') exactP++; else exactB++;
    }
  }
  if (exactP + exactB >= 4 && Math.max(exactP, exactB) / (exactP + exactB) >= 0.70) {
    const side = exactP > exactB ? 'P' : 'B';
    const conf = Math.round((Math.max(exactP, exactB) / (exactP + exactB)) * 100);
    return { side, conf: Math.min(90, conf), note: `EXACT PREFIX: ${exactP + exactB} shoes (${exactP}P / ${exactB}B).` };
  }

  // 2. 20-Hand Elite Trajectory Lock
  if (pbSeq.length >= 18) {
    let bestShoe = null, bestSim = 0;
    for (const shObj of cachedLibrary) {
      const shPB = shObj.pb;
      if (shPB.length <= pbSeq.length) continue;
      let same = 0;
      for (let i = 0; i < pbSeq.length; i++) if (shPB[i] === pbSeq[i]) same++;
      const sim = same / pbSeq.length;
      if (sim > bestSim) { bestSim = sim; bestShoe = shPB; }
    }
    if (bestShoe && bestSim >= 0.80) {
      const nx = bestShoe[pbSeq.length];
      return { side: nx, conf: Math.round(bestSim * 100), note: `20-Hand Trajectory Lock (${Math.round(bestSim * 100)}% shoe match).` };
    }
  }

  // 3. Sliding + Inverted + Tie-Context + Rhythm (1 best vote per independent shoe)
  const inv = s => s.replace(/[PB]/g, c => c === 'P' ? 'B' : 'P');
  const liveRhythm = computeRhythm(pbSeq);
  const curLast = pbSeq.at(-1);
  let pWeight = 0, bWeight = 0, pN = 0, bN = 0;

  for (const shObj of cachedLibrary) {
    const sp = shObj.pb, sr = shObj.raw, st = shObj.rhythm;
    let bestVote = null, bestW = 0;

    // Tie-context window (especially strong right after a Tie)
    if (!state.ignoreTies && liveRaw.length >= 6) {
      for (const n of [10, 8, 6]) {
        if (liveRaw.length < n || sr.length <= n) continue;
        const pat = liveRaw.slice(-n);
        let pos = sr.indexOf(pat);
        while (pos !== -1) {
          const nx = nextNonTie(sr, pos + n);
          const w = 2.0 + n * 0.34 + (liveRaw.endsWith('T') ? 1.1 : 0);
          if (nx && w > bestW) { bestW = w; bestVote = nx; }
          pos = sr.indexOf(pat, pos + 1);
        }
      }
    }

    // Exact & Inverted P/B windows
    for (const n of [14, 12, 10, 8, 6]) {
      if (pbSeq.length < n || sp.length <= n) continue;
      const pat = pbSeq.slice(-n);
      let pos = sp.indexOf(pat);
      while (pos !== -1) {
        if (pos + n < sp.length) {
          const w = 1.2 + n * 0.34 + (Math.abs((pos + n) - pbSeq.length) <= 8 ? 0.5 : 0);
          if (w > bestW) { bestW = w; bestVote = sp[pos + n]; }
        }
        pos = sp.indexOf(pat, pos + 1);
      }
      const ipat = inv(pat);
      pos = sp.indexOf(ipat);
      while (pos !== -1) {
        if (pos + n < sp.length) {
          const w = 0.85 + n * 0.34 + (Math.abs((pos + n) - pbSeq.length) <= 8 ? 0.5 : 0);
          if (w > bestW) { bestW = w; bestVote = inv(sp[pos + n]); }
        }
        pos = sp.indexOf(ipat, pos + 1);
      }
    }

    // Rhythm window
    for (const n of [10, 8, 6]) {
      if (liveRhythm.length < n || st.length <= n) continue;
      const pat = liveRhythm.slice(-n);
      const pos = st.lastIndexOf(pat);
      if (pos !== -1 && pos + n < st.length) {
        const w = 1.0 + n * 0.30;
        if (w > bestW) { bestW = w; bestVote = st[pos + n] === 'R' ? curLast : inv(curLast); }
      }
    }

    if (bestVote === 'P') { pWeight += bestW; pN++; }
    else if (bestVote === 'B') { bWeight += bestW; bN++; }
  }

  const totalShoes = pN + bN;
  if (totalShoes < 6 || pWeight === bWeight) {
    return { side: null, conf: 0, note: `WAIT: ${totalShoes}/6 independent shoes matched.` };
  }
  const side = pWeight > bWeight ? 'P' : 'B';
  const share = Math.max(pWeight, bWeight) / (pWeight + bWeight);
  if (share < 0.55) return { side: null, conf: Math.round(share * 100), note: `WAIT: Low margin (${pN}P vs ${bN}B).` };

  const conf = Math.min(89, Math.round(share * 100));
  return { side, conf, note: `${totalShoes} independent shoes (${pN}P / ${bN}B) • ${conf}% vote.` };
}

// --- RELIABILITY & STREAK HELPERS ---
function getEngineStats(key) {
  const l = state.ledgers[key];
  const tot = l.w + l.l;
  const rate = tot ? l.w / tot : 0.5;
  let hot = 0;
  for (let i = l.hist.length - 1; i >= 0 && l.hist[i] === 'W'; i--) hot++;
  const h6 = l.hist.slice(-6).join('');
  const alt = (h6 === 'WLWLWL' || h6 === 'LWLWLW');
  const shrunkRate = 0.5 + (rate - 0.5) * (tot / (tot + 6));
  const multiplier = Math.max(0.6, shrunkRate * 1.6) * (hot >= 3 ? 1.25 : 1.0);
  return { tot, rate, pct: tot ? Math.round(rate * 100) : null, hot, alt, multiplier };
}

// --- MASTER CONSENSUS ENGINE ---
function computeMasterDecision() {
  const out = {
    roadPreview: runRoadPreviewAI(),
    seqV2: runSequenceAIV2(),
    derivedV3: runDerivedRoadAIV3(),
    beadHist: runBeadHistoryV503()
  };

  const keys = ['roadPreview', 'seqV2', 'derivedV3', 'beadHist'];
  const baseWeights = { roadPreview: 1.20, seqV2: 1.15, derivedV3: 1.00, beadHist: 1.05 };

  let leaderKey = null, bestRate = -1;
  keys.forEach(k => {
    const st = getEngineStats(k);
    if (st.tot >= 4 && st.rate > bestRate) { bestRate = st.rate; leaderKey = k; }
  });

  let pScore = 0, bScore = 0, pCount = 0, bCount = 0;
  keys.forEach(k => {
    const res = out[k];
    const st = getEngineStats(k);
    if (res.side === 'P' || res.side === 'B') {
      const w = baseWeights[k] * st.multiplier * (res.conf / 100) * (k === leaderKey ? 1.20 : 1.0);
      if (res.side === 'P') { pScore += w; pCount++; }
      else { bScore += w; bCount++; }
    }
  });

  const activeEngines = pCount + bCount;
  let masterSide = null, masterConf = 0, masterReason = '';

  if (activeEngines === 0) {
    masterReason = 'WAIT — All 4 core engines are holding for stronger pattern evidence.';
  } else if (pCount > 0 && bCount > 0 && Math.abs(pScore - bScore) / (pScore + bScore) < 0.20) {
    masterReason = `WAIT (CONFLICT LOCK) — Engines are split (${pCount} Player vs ${bCount} Banker). Skipping risky hand.`;
  } else {
    masterSide = pScore >= bScore ? 'P' : 'B';
    const winCount = masterSide === 'P' ? pCount : bCount;
    const dominance = Math.max(pScore, bScore) / (pScore + bScore);
    masterConf = Math.min(94, Math.round(52 + dominance * 36 + (winCount - 1) * 3));
    masterReason = `QUALIFIED ${masterSide === 'P' ? 'PLAYER' : 'BANKER'} — ${winCount}/${activeEngines} active engines agree${leaderKey && out[leaderKey].side === masterSide ? ' (Backed by Live Leader)' : ''}.`;
  }

  return { out, leaderKey, master: { side: masterSide, conf: masterConf, reason: masterReason, agree: `${Math.max(pCount, bCount)}/${activeEngines}` } };
}

// --- AUTHORITATIVE PRE-COMMIT GRADING & UNDO SNAPSHOT ---
function commitHand(actual) {
  // Save snapshot for clean Undo
  state.undoStack.push(JSON.stringify({ hands: state.hands, ledgers: state.ledgers }));
  if (state.undoStack.length > 80) state.undoStack.shift();

  // Grade pending predictions on P or B (Ties do not grade P/B calls as win or loss)
  if (actual === 'P' || actual === 'B') {
    ['roadPreview', 'seqV2', 'derivedV3', 'beadHist', 'master'].forEach(k => {
      const lg = state.ledgers[k];
      if (lg.pending === 'P' || lg.pending === 'B') {
        if (lg.pending === actual) { lg.w++; lg.hist.push('W'); }
        else { lg.l++; lg.hist.push('L'); }
        if (lg.hist.length > 24) lg.hist.shift();
      }
      lg.pending = null;
    });
  }

  state.hands.push(actual);
  renderAll();
  saveState();
}

function undoHand() {
  if (!state.hands.length) return;
  if (state.undoStack.length > 0) {
    const prev = JSON.parse(state.undoStack.pop());
    state.hands = prev.hands;
    state.ledgers = prev.ledgers;
  } else {
    state.hands.pop();
    ['roadPreview', 'seqV2', 'derivedV3', 'beadHist', 'master'].forEach(k => state.ledgers[k].pending = null);
  }
  renderAll();
  saveState();
}

function newShoe() {
  if (!confirm('Clear current shoe hands and start a fresh shoe?')) return;
  state.hands = [];
  state.undoStack = [];
  ['roadPreview', 'seqV2', 'derivedV3', 'beadHist', 'master'].forEach(k => state.ledgers[k].pending = null);
  renderAll();
  saveState();
}

function renderDerivedRoadGrid(id, marks, style) {
  const el = document.getElementById(id);
  el.innerHTML = '';
  const pos = placeRoadSequence(marks.map(m => ({ m })), x => x.m);
  const maxCol = Math.max(12, ...pos.map(x => x.col));
  el.style.gridTemplateColumns = `repeat(${maxCol + 2}, 12px)`;
  pos.forEach(x => {
    const cell = document.createElement('div');
    cell.className = 'd-cell';
    cell.style.gridColumn = x.col + 1;
    cell.style.gridRow = x.row + 1;
    const mark = document.createElement('div');
    const color = x.m === 'R' ? 'red' : 'blue';
    mark.className = `d-mark ${color}-${style}`;
    cell.appendChild(mark);
    el.appendChild(cell);
  });
  el.scrollLeft = el.scrollWidth;
}

function renderAll() {
  const decision = computeMasterDecision();

  // Arm pending calls for the next hand
  ['roadPreview', 'seqV2', 'derivedV3', 'beadHist'].forEach(k => {
    state.ledgers[k].pending = decision.out[k].side;
  });
  state.ledgers.master.pending = decision.master.side;

  // 1. Render Master Box
  const m = decision.master;
  const orb = document.getElementById('masterOrb');
  orb.className = 'master-orb ' + (m.side || '');
  orb.textContent = m.side || 'WAIT';
  document.getElementById('masterTitle').textContent = m.side ? (m.side === 'P' ? 'BET PLAYER (P)' : 'BET BANKER (B)') : 'WAIT / NO BET';
  document.getElementById('masterReason').textContent = m.reason;
  document.getElementById('masterConf').textContent = m.side ? m.conf + '%' : '—';
  document.getElementById('masterAgree').textContent = m.agree;
  const mSt = getEngineStats('master');
  document.getElementById('masterWL').textContent = `${state.ledgers.master.w}W-${state.ledgers.master.l}L (${mSt.pct !== null ? mSt.pct + '%' : '—'})`;

  // 2. Render 4 Engine Cards
  ['roadPreview', 'seqV2', 'derivedV3', 'beadHist'].forEach(k => {
    const r = decision.out[k];
    const st = getEngineStats(k);
    const card = document.getElementById('card_' + k);
    card.classList.toggle('leader', decision.leaderKey === k);

    const pickEl = document.getElementById('pick_' + k);
    pickEl.className = 'eng-pick ' + (r.side || 'WAIT');
    pickEl.textContent = r.side === 'P' ? 'PLAYER (P)' : r.side === 'B' ? 'BANKER (B)' : 'WAIT';

    document.getElementById('note_' + k).textContent = r.note;
    document.getElementById('conf_' + k).textContent = r.conf ? `Conf: ${r.conf}%` : 'Conf: —';
    document.getElementById('wl_' + k).textContent = `${state.ledgers[k].w}W-${state.ledgers[k].l}L (${st.pct !== null ? st.pct + '%' : '—'})`;

    let bHtml = '';
    if (decision.leaderKey === k) bHtml += `<span class="badge gold">👑 LEADER</span>`;
    if (st.hot >= 3) bHtml += `<span class="badge hot">🔥 HOT ${st.hot}W</span>`;
    if (st.alt) bHtml += `<span class="badge">⚡ ALT</span>`;
    document.getElementById('badges_' + k).innerHTML = bHtml;
  });

  // 3. Render Last Result & Chronological Recent Results Strip (Includes P, B, and T)
  const lastBadge = document.getElementById('lastResultBadge');
  const lastText = document.getElementById('lastResultText');
  const strip = document.getElementById('recentResultsStrip');
  if (!state.hands.length) {
    lastBadge.className = 'chip none';
    lastBadge.textContent = '—';
    lastText.textContent = 'None';
    strip.innerHTML = `<span style="font-size:11px;color:var(--muted)">Recent P / B / T results will appear here in order...</span>`;
  } else {
    const last = state.hands.at(-1);
    lastBadge.className = 'chip ' + last;
    lastBadge.textContent = last;
    lastText.textContent = last === 'P' ? `Player (#${state.hands.length})` : last === 'B' ? `Banker (#${state.hands.length})` : `Tie (#${state.hands.length})`;
    strip.innerHTML = state.hands.slice(-28).map(h => `<span class="chip ${h}">${h}</span>`).join('');
    strip.scrollLeft = strip.scrollWidth;
  }

  // 4. Render Big Road (Dragon Tail + Green Tie Badges + Tie-First Hand Support)
  const brGrid = document.getElementById('bigRoadGrid');
  brGrid.innerHTML = '';
  const { placed, leadingTiesOnly } = bigRoadPositions(state.hands);
  const maxCol = Math.max(19, ...placed.map(x => x.col));
  brGrid.style.gridTemplateColumns = `repeat(${maxCol + 2}, 28px)`;

  if (placed.length === 0 && leadingTiesOnly > 0) {
    const cell = document.createElement('div');
    cell.className = 'br-cell';
    cell.style.gridColumn = 1;
    cell.style.gridRow = 1;
    const mark = document.createElement('div');
    mark.className = 'br-mark T';
    mark.textContent = 'T';
    if (leadingTiesOnly > 1) {
      const cnt = document.createElement('span');
      cnt.className = 'tie-count';
      cnt.textContent = leadingTiesOnly;
      mark.appendChild(cnt);
    }
    cell.appendChild(mark);
    brGrid.appendChild(cell);
  } else {
    placed.forEach(x => {
      const cell = document.createElement('div');
      cell.className = 'br-cell';
      cell.style.gridColumn = x.col + 1;
      cell.style.gridRow = x.row + 1;
      const mark = document.createElement('div');
      mark.className = 'br-mark ' + x.r;
      mark.textContent = x.r;
      if (x.ties > 0) {
        const slash = document.createElement('i');
        slash.className = 'tie-slash';
        mark.appendChild(slash);
        const cnt = document.createElement('span');
        cnt.className = 'tie-count';
        cnt.textContent = x.ties > 1 ? `${x.ties}T` : 'T';
        mark.appendChild(cnt);
      }
      cell.appendChild(mark);
      brGrid.appendChild(cell);
    });
  }
  const brScroll = document.getElementById('bigRoadScroll');
  brScroll.scrollLeft = brScroll.scrollWidth;

  // 5. Render Derived Roads (Authentic Dragon Tail + Symbols)
  renderDerivedRoadGrid('eyeGrid', deriveRoad(state.hands, 1), 'ring');
  renderDerivedRoadGrid('smallGrid', deriveRoad(state.hands, 2), 'dot');
  renderDerivedRoadGrid('roachGrid', deriveRoad(state.hands, 3), 'slash');

  // 6. Stats & Probes
  const n = state.hands.length;
  const pN = state.hands.filter(x => x === 'P').length;
  const bN = state.hands.filter(x => x === 'B').length;
  const tN = state.hands.filter(x => x === 'T').length;
  const pct = v => n ? Math.round((v * 100) / n) : 0;
  document.getElementById('shoeStatsLabel').textContent = `Hands: ${n} • P: ${pN} (${pct(pN)}%) • B: ${bN} (${pct(bN)}%) • T: ${tN} (${pct(tN)}%)`;

  const pEye = previewDerivedMark(state.hands, 'P', 1) || '—', bEye = previewDerivedMark(state.hands, 'B', 1) || '—';
  const pSm = previewDerivedMark(state.hands, 'P', 2) || '—', bSm = previewDerivedMark(state.hands, 'B', 2) || '—';
  const pRc = previewDerivedMark(state.hands, 'P', 3) || '—', bRc = previewDerivedMark(state.hands, 'B', 3) || '—';
  document.getElementById('eyeProbeText').textContent = `P→${pEye} | B→${bEye}`;
  document.getElementById('smallProbeText').textContent = `P→${pSm} | B→${bSm}`;
  document.getElementById('roachProbeText').textContent = `P→${pRc} | B→${bRc}`;
  document.getElementById('probeLabel').textContent = `If P: ${pEye}/${pSm}/${pRc} • If B: ${bEye}/${bSm}/${bRc}`;
  document.getElementById('libStatusText').textContent = `Library: ${cachedLibrary.length} Verified Shoes Active • ${state.ignoreTies ? 'P/B Search Mode (Ties Ignored)' : 'Full P/B/T Search Mode'}`;
}

// --- PERSISTENCE & CONTROLS ---
function loadState() {
  try {
    const raw = JSON.parse(localStorage.getItem(STORAGE_KEY));
    if (raw && typeof raw === 'object') {
      if (Array.isArray(raw.hands)) state.hands = raw.hands;
      state.ignoreTies = !!raw.ignoreTies;
      const merged = new Set([...PREINSTALLED_195_SHOES, ...(raw.library || [])]);
      state.library = [...merged];
      if (raw.ledgers) state.ledgers = raw.ledgers;
    }
  } catch (e) {}
  document.getElementById('ignoreTiesToggle').checked = state.ignoreTies;
  rebuildLibraryCache();
}

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({
      hands: state.hands,
      ignoreTies: state.ignoreTies,
      library: state.library,
      ledgers: state.ledgers
    }));
  } catch (e) {}
}

document.getElementById('ignoreTiesToggle').addEventListener('change', e => {
  state.ignoreTies = !!e.target.checked;
  renderAll();
  saveState();
});

document.getElementById('resetAccBtn').addEventListener('click', () => {
  if (!confirm('Reset all Win/Loss accuracy counters to 0W-0L?')) return;
  state.ledgers = freshLedgers();
  renderAll();
  saveState();
});

document.getElementById('importV506Input').addEventListener('change', async e => {
  const file = e.target.files?.[0];
  if (!file) return;
  const text = await file.text();
  const extracted = [];
  const seqRegex = /"sequence"\s*:\s*"([PBT]{6,})"/g;
  let m;
  while ((m = seqRegex.exec(text)) !== null) extracted.push(m[1]);
  if (!extracted.length) {
    const fallback = text.match(/\b[PBT]{25,120}\b/g) || [];
    extracted.push(...fallback);
  }
  const before = state.library.length;
  state.library = [...new Set([...state.library, ...extracted])];
  rebuildLibraryCache();
  saveState();
  renderAll();
  alert(`Imported ${state.library.length - before} new shoes! Total active library: ${state.library.length} shoes.`);
  e.target.value = '';
});

document.getElementById('saveCurrentShoeBtn').addEventListener('click', () => {
  const seq = state.hands.join('');
  if (seq.length < 12) return alert('Enter at least 12 hands before saving a shoe to the library.');
  if (!state.library.includes(seq)) {
    state.library.push(seq);
    rebuildLibraryCache();
    saveState();
    renderAll();
    alert(`Saved current shoe (${seq.length} hands) to library! Total shoes: ${state.library.length}`);
  } else {
    alert('This exact shoe sequence is already in the library.');
  }
});

loadState();
renderAll();
</script>
