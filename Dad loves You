<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"/>
<title>Master Elite Baccarat AI Toolkit v2.0</title>
<style>
  :root {
    --bg: #0b0e14; --panel: #141923; --panel2: #1d2432; --line: #2d3748;
    --text: #f7fafc; --muted: #a0aec0; --p: #265cff; --b: #e63b35; --t: #1cab59;
    --gold: #f1b827; --hot: #38a169;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding-bottom: 115px; }
  .app { max-width: 1140px; margin: 0 auto; padding: 10px; }

  /* Header & Controls Bar */
  .topbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 14px; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; margin-bottom: 10px; }
  .brand h1 { margin: 0; font-size: 17px; font-weight: 900; letter-spacing: .3px; color: #fff; }
  .brand span { font-size: 11px; color: #68d391; font-weight: 700; display: block; margin-top: 2px; }
  .lib-bar { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
  .btn-sm { background: var(--panel2); color: #fff; border: 1px solid #4a5568; padding: 7px 10px; border-radius: 9px; font-size: 11px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; }
  .btn-sm.primary { background: #2b6cb0; border-color: #4299e1; }
  .toggle-label { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; background: #101e20; border: 1px solid #319795; color: #81e6d9; padding: 6px 10px; border-radius: 9px; cursor: pointer; }
  .toggle-label input { accent-color: #319795; width: 15px; height: 15px; margin: 0; }

  /* Master Consensus Box */
  .master-box { background: linear-gradient(145deg, #162032, #111722); border: 2px solid var(--gold); border-radius: 16px; padding: 15px; margin-bottom: 10px; box-shadow: 0 8px 25px rgba(0,0,0,0.4); }
  .master-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .master-call-wrap { display: flex; align-items: center; gap: 14px; }
  .master-orb { width: 62px; height: 62px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 900; background: #2d3748; border: 3px solid #4a5568; color: #fff; flex-shrink: 0; }
  .master-orb.P { background: linear-gradient(#3e6fff, #173fd0); border-color: #90cdf4; box-shadow: 0 0 20px rgba(38,92,255,.5); }
  .master-orb.B { background: linear-gradient(#ff5b55, #bf2320); border-color: #feb2b2; box-shadow: 0 0 20px rgba(230,59,53,.5); }
  .master-info h2 { margin: 0; font-size: 22px; font-weight: 900; }
  .master-info p { margin: 4px 0 0; font-size: 12px; color: var(--muted); line-height: 1.35; }
  .master-metrics { display: flex; gap: 8px; text-align: center; flex-wrap: wrap; }
  .m-stat { background: rgba(255,255,255,0.04); border: 1px solid var(--line); border-radius: 10px; padding: 7px 11px; min-width: 82px; }
  .m-stat b { display: block; font-size: 16px; color: #fff; }
  .m-stat span { font-size: 9px; color: var(--muted); text-transform: uppercase; font-weight: 700; }

  /* 4 Core Engines Grid */
  .engines-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; margin-bottom: 10px; }
  .eng-card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 11px; position: relative; }
  .eng-card.leader { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold) inset; }
  .eng-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 4px; margin-bottom: 6px; }
  .eng-name { font-size: 12px; font-weight: 800; color: #e2e8f0; }
  .badges { display: flex; gap: 4px; flex-wrap: wrap; }
  .badge { font-size: 9px; font-weight: 900; padding: 2px 6px; border-radius: 99px; background: #2d3748; color: #cbd5e0; }
  .badge.gold { background: #744210; color: #fefcbf; }
  .badge.hot { background: #22543d; color: #9ae6b4; }
  .eng-pick { font-size: 20px; font-weight: 900; margin: 4px 0; }
  .eng-pick.P { color: #63b3ed; } .eng-pick.B { color: #fc8181; } .eng-pick.WAIT { color: #718096; }
  .eng-meta { font-size: 11px; color: var(--muted); display: flex; justify-content: space-between; border-top: 1px solid #252f3f; padding-top: 6px; margin-top: 6px; font-weight: 700; }
  .eng-note { font-size: 10px; color: #8da0b8; margin-top: 4px; line-height: 1.3; min-height: 26px; }

  /* Recent Results Strip (Shows P, B, and T immediately) */
  .recent-strip-box { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 9px 12px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .last-result-pill { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; color: #cbd5e0; flex-shrink: 0; }
  .chip { width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 900; color: #fff; flex-shrink: 0; }
  .chip.P { background: var(--p); }
  .chip.B { background: var(--b); }
  .chip.T { background: var(--t); box-shadow: 0 0 8px rgba(28,171,89,0.5); }
  .chip.none { background: #2d3748; color: #718096; }
  .recent-chips { display: flex; align-items: center; gap: 5px; overflow-x: auto; flex: 1; padding: 2px 0; }
  .recent-chips .chip { width: 24px; height: 24px; font-size: 11px; }

  /* Roadmaps */
  .roads-container { display: grid; grid-template-columns: 1.45fr 1fr; gap: 10px; margin-bottom: 12px; }
  .road-box { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 10px; overflow: hidden; }
  .box-title { font-size: 12px; font-weight: 800; color: #cbd5e0; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px; }
  .road-scroll { overflow-x: auto; background: #f8f9fb; border-radius: 8px; padding: 6px; border: 1px solid #313740; }
  .big-road { display: grid; grid-template-rows: repeat(6, 28px); grid-auto-flow: column; grid-auto-columns: 28px; width: max-content; min-width: 100%; background: linear-gradient(#dfe3e8 1px, transparent 1px), linear-gradient(90deg, #dfe3e8 1px, transparent 1px); background-size: 28px 28px; }
  .br-cell { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; position: relative; }
  .br-mark { width: 23px; height: 23px; border-radius: 50%; border: 3px solid; font-size: 11px; font-weight: 900; display: flex; align-items: center; justify-content: center; background: #fff; position: relative; }
  .br-mark.P { border-color: var(--p); color: var(--p); }
  .br-mark.B { border-color: var(--b); color: var(--b); }
  .br-mark.T { border-color: var(--t); color: var(--t); }
  .tie-slash { position: absolute; width: 14px; height: 2.5px; background: var(--t); transform: rotate(-45deg); border-radius: 2px; pointer-events: none; }
  .tie-count { position: absolute; right: -3px; bottom: -3px; background: var(--t); color: #fff; font-size: 8px; font-weight: 900; border-radius: 99px; min-width: 13px; height: 13px; padding: 0 3px; display: flex; align-items: center; justify-content: center; border: 1px solid #fff; }

  .derived-wrap { display: grid; grid-template-rows: repeat(3, 1fr); gap: 6px; }
  .derived-subbox { background: #0f131c; border: 1px solid #232a36; border-radius: 7px; padding: 4px 6px; }
  .derived-subbox-title { font-size: 10px; font-weight: 800; color: #9ca5b1; margin-bottom: 3px; display: flex; justify-content: space-between; }
  .derived-grid { display: grid; grid-template-rows: repeat(6, 12px); grid-auto-flow: column; grid-auto-columns: 12px; gap: 1px; overflow-x: auto; min-height: 76px; padding-bottom: 2px; }
  .d-cell { width: 12px; height: 12px; display: flex; align-items: center; justify-content: center; }
  .d-mark { width: 9px; height: 9px; border-radius: 50%; }
  .d-mark.red-ring { border: 2px solid var(--b); background: transparent; }
  .d-mark.blue-ring { border: 2px solid var(--p); background: transparent; }
  .d-mark.red-dot { background: var(--b); }
  .d-mark.blue-dot { background: var(--p); }
  .d-mark.red-slash, .d-mark.blue-slash { width: 10px; height: 2.2px; border-radius: 2px; transform: rotate(-45deg); }
  .d-mark.red-slash { background: var(--b); }
  .d-mark.blue-slash { background: var(--p); }

  /* Bottom Sticky Controls */
  .controls-dock { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(20, 25, 35, 0.96); backdrop-filter: blur(8px); border-top: 1px solid var(--line); padding: 10px; z-index: 999; }
  .dock-inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr .65fr .65fr; gap: 8px; }
  .btn-input { border: 0; border-radius: 14px; color: #fff; font-size: 22px; font-weight: 900; padding: 14px 0; cursor: pointer; box-shadow: inset 0 1px rgba(255,255,255,.25), 0 4px 12px rgba(0,0,0,0.3); user-select: none; }
  .btn-input:active { transform: scale(0.98); }
  .btn-input.P { background: linear-gradient(#3e6fff, #173fd0); }
  .btn-input.B { background: linear-gradient(#ff5b55, #bf2320); }
  .btn-input.T { background: linear-gradient(#33c86c, #117c3a); }
  .btn-input.undo { background: linear-gradient(#f5c74c, #d99412); font-size: 16px; }
  .btn-input.reset { background: #3b434d; font-size: 14px; }

  @media (max-width: 820px) {
    .engines-grid { grid-template-columns: repeat(2, 1fr); }
    .roads-container { grid-template-columns: 1fr; }
    .btn-input { font-size: 18px; padding: 12px 0; }
  }
</style>
</head>
<body>
<div class="app">
